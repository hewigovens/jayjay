set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

root := absolute_path(source_directory() / "..")
project := root / "shell" / "mac"
derived_data := root / "build" / "DerivedData"
app := derived_data / "Build" / "Products" / "Debug" / "JayJay.app"
crate_name := "jayjay_uniffi"
lib_name := "lib" + crate_name + ".a"
bindings_dir := root / "build" / "bindings"
headers_dir := bindings_dir / "Headers"
xcframework := project / "JayJayFFI.xcframework"
swift_out := project / "Sources" / "JayJayCore"
macos_target := "aarch64-apple-darwin"
deployment_target := "15.0"
bindgen_bin_debug := root / "target" / "debug" / "uniffi-bindgen"
bindgen_bin_release := root / "target" / "release" / "uniffi-bindgen"
target_dir := root / "target"
uniffi_config := root / "crates" / "jayjay-uniffi" / "uniffi.toml"
macos_min_flag := "-mmacosx-version-min=" + deployment_target
debug_lib_path := target_dir / macos_target / "debug" / lib_name
release_lib_path := target_dir / macos_target / "release" / lib_name
signing_identity := "Developer ID Application: Tao Xu (V28VJH6B6S)"
team_id := "V28VJH6B6S"
bundle_id := "dev.hewig.jayjay"
app_name := "JayJay"
version := "0.2.15"
build_number := "19"
release_dir := root / "build" / "release"

default: list

list:
  @echo "shell recipes:"
  @echo "  just shell::ffi               Rebuild Rust FFI, bindings, and XCFramework (debug)"
  @echo "  just shell::ffi-release       Rebuild Rust FFI, bindings, and XCFramework (release)"
  @echo "  just shell::build            Build the macOS app"
  @echo "  just shell::test             Run the macOS app unit tests"
  @echo "  just shell::run              Build and launch the app"
  @echo "  just shell::run /path/to/repo Build and launch the app for a repo"
  @echo "  just shell::format           Format Swift sources"
  @echo "  just shell::lint             Lint Swift sources"
  @echo "  just shell::clean            Remove generated shell/macOS build artifacts"
  @echo "  just shell::release          Build, sign, notarize, and package for release"
  @echo "  just shell::release-dry-run  Build and package without signing/notarization"
  @echo "  just shell::build-apple      Legacy Apple/XCFramework build flow"

ffi: ffi-debug

ffi-debug:
  mkdir -p "{{bindings_dir}}" "{{headers_dir}}" "{{swift_out}}"
  MACOSX_DEPLOYMENT_TARGET="{{deployment_target}}" \
  CFLAGS_aarch64_apple_darwin="{{macos_min_flag}}" \
  CXXFLAGS_aarch64_apple_darwin="{{macos_min_flag}}" \
  RUSTFLAGS="-C link-arg={{macos_min_flag}}" \
  cargo build --target "{{macos_target}}" -p jayjay-uniffi
  cargo build -p jayjay-uniffi --bin uniffi-bindgen
  "{{bindgen_bin_debug}}" generate \
    --library "{{debug_lib_path}}" \
    --language swift \
    --out-dir "{{bindings_dir}}" \
    --config "{{uniffi_config}}"
  cp "{{bindings_dir}}/JayJayFFI.h" "{{headers_dir}}/"
  cp "{{bindings_dir}}/JayJayFFI.modulemap" "{{headers_dir}}/module.modulemap"
  cp "{{bindings_dir}}/JayJayCore.swift" "{{swift_out}}/"
  rm -rf "{{xcframework}}"
  xcodebuild -create-xcframework \
    -library "{{debug_lib_path}}" \
    -headers "{{headers_dir}}" \
    -output "{{xcframework}}" | xcbeautify

ffi-release:
  mkdir -p "{{bindings_dir}}" "{{headers_dir}}" "{{swift_out}}"
  MACOSX_DEPLOYMENT_TARGET="{{deployment_target}}" \
  CFLAGS_aarch64_apple_darwin="{{macos_min_flag}}" \
  CXXFLAGS_aarch64_apple_darwin="{{macos_min_flag}}" \
  RUSTFLAGS="-C link-arg={{macos_min_flag}}" \
  cargo build --release --target "{{macos_target}}" -p jayjay-uniffi
  cargo build --release -p jayjay-uniffi --bin uniffi-bindgen
  "{{bindgen_bin_release}}" generate \
    --library "{{release_lib_path}}" \
    --language swift \
    --out-dir "{{bindings_dir}}" \
    --config "{{uniffi_config}}"
  cp "{{bindings_dir}}/JayJayFFI.h" "{{headers_dir}}/"
  cp "{{bindings_dir}}/JayJayFFI.modulemap" "{{headers_dir}}/module.modulemap"
  cp "{{bindings_dir}}/JayJayCore.swift" "{{swift_out}}/"
  rm -rf "{{xcframework}}"
  xcodebuild -create-xcframework \
    -library "{{release_lib_path}}" \
    -headers "{{headers_dir}}" \
    -output "{{xcframework}}" | xcbeautify

build: ffi sync-icon
  cargo build -p jayjay-cli
  xcodegen --spec "{{project}}/project.yml" --project "{{project}}"
  xcodebuild \
    -project "{{project}}/JayJay.xcodeproj" \
    -scheme JayJay \
    -configuration Debug \
    -sdk macosx \
    -derivedDataPath "{{derived_data}}" \
    build | xcbeautify
  cp "{{target_dir}}/debug/jayjay" "{{app}}/Contents/MacOS/jayjay-cli"
  codesign --force --sign - "{{app}}"
  @echo "Built {{app}}"

test: ffi sync-icon
  xcodegen --spec "{{project}}/project.yml" --project "{{project}}"
  xcodebuild \
    -project "{{project}}/JayJay.xcodeproj" \
    -scheme JayJay \
    -configuration Debug \
    -sdk macosx \
    -derivedDataPath "{{derived_data}}" \
    test | xcbeautify

# Build deterministic jj fixtures at /tmp/jayjay-test-fixtures and set the
# onboarding-complete user default so fresh machines don't show the welcome
# screen during tests.
ui-test-setup:
  #!/usr/bin/env bash
  set -euo pipefail
  defaults write {{bundle_id}} jayjay.hasCompletedOnboarding -bool YES

  root=/tmp/jayjay-test-fixtures
  rm -rf "$root"
  mkdir -p "$root"

  # Simple: three commits + an active working copy with two new files.
  # Clone once, then copy per-class for tests that mutate repo state so leaks
  # don't bleed across scenes (NewChangeScene creates a new @).
  jj git init --colocate "$root/simple"
  (
    cd "$root/simple"
    echo "# Sample project" > README.md
    jj describe -m "initial"
    jj new -m "add hello"
    echo "hello" > hello.txt
    jj new -m "add feature"
    echo "feature" > feature.txt
    jj bookmark create main -r @
    jj new
    echo "wip 1" > wip1.txt
    echo "wip 2" > wip2.txt
  )
  cp -R "$root/simple" "$root/simple-newchange"
  cp -R "$root/simple" "$root/simple-commit"

  # Conflict: @ is a rebased change that conflicts with main on file.txt
  jj git init --colocate "$root/conflict"
  (
    cd "$root/conflict"
    printf "line1\nline2\nline3\n" > file.txt
    jj describe -m "base"
    jj bookmark create main -r @
    jj new -m "main: line 2 changed"
    printf "line1\nline2 MAIN\nline3\n" > file.txt
    jj bookmark set main -r @
    jj new -r 'main-' -m "feature: line 2 differently"
    printf "line1\nline2 FEATURE\nline3\n" > file.txt
    jj rebase -r @ -d main
  )

# Run the macOS UI test bundle. Pass a test-id to narrow the run, e.g.:
#   just shell::ui-test JayJayUITests/CommandPaletteScene/testOpenAndSearch
ui-test test_id='': ffi sync-icon ui-test-setup
  #!/usr/bin/env bash
  set -euo pipefail
  xcodegen --spec "{{project}}/project.yml" --project "{{project}}"
  args=(
    -project "{{project}}/JayJay.xcodeproj"
    -scheme JayJayUITests
    -configuration Debug
    -sdk macosx
    -derivedDataPath "{{derived_data}}"
  )
  if [[ -n "{{test_id}}" ]]; then
    args+=(-only-testing:"{{test_id}}")
  fi
  xcodebuild "${args[@]}" test | xcbeautify

run repo='': build
  @killall JayJay 2>/dev/null || true
  @if [[ -n "{{repo}}" ]]; then \
    repo_path="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "{{repo}}")"; \
    open -n "{{app}}" --args --repo "$repo_path"; \
  else \
    open -n "{{app}}"; \
  fi

format:
  cd "{{project}}" && swiftformat Sources/

sync-icon:
  cp "{{root}}/docs/icon.svg" "{{project}}/Resources/app.icon/Assets/jaybird.svg"

lint:
  swiftlint lint --config "{{root}}/.swiftlint.yml" --quiet

clean:
  rm -rf "{{root}}/build" "{{xcframework}}" "{{project}}/JayJay.xcodeproj" "{{swift_out}}/JayJayCore.swift"
  rm -f "{{project}}/Resources/app.icon/Assets/jaybird.svg"
  find "{{root}}" -name ".DS_Store" -delete

import "release.just"

build-apple: ffi-debug
