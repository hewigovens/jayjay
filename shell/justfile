# === GPUI shell (alpha, cross-platform) ===

# Build a .app bundle for the GPUI shell (ad-hoc signed so launchd accepts it).
gpui-bundle:
  @cargo build -p jayjay-gpui
  @mkdir -p "{{root}}/build/gpui/JayJay.app/Contents/MacOS"
  @mkdir -p "{{root}}/build/gpui/JayJay.app/Contents/Resources"
  @cp "{{root}}/shell/gpui/Info.plist" "{{root}}/build/gpui/JayJay.app/Contents/Info.plist"
  @cp "{{root}}/assets/AppIcon.icns" "{{root}}/build/gpui/JayJay.app/Contents/Resources/AppIcon.icns"
  @cp "{{root}}/target/debug/jayjay-gpui" "{{root}}/build/gpui/JayJay.app/Contents/MacOS/jayjay-gpui"
  @xattr -dr com.apple.quarantine "{{root}}/build/gpui/JayJay.app" 2>/dev/null || true
  @codesign --force --deep --sign - "{{root}}/build/gpui/JayJay.app"
  @touch "{{root}}/build/gpui/JayJay.app"
  @echo "Built {{root}}/build/gpui/JayJay.app"

# Run the GPUI shell .app. Pass a repo path or default to the invocation directory.
# Kills any previously-launched jayjay-gpui first so we don't run two copies of
# the alpha shell racing each other.
gpui-run repo='': gpui-bundle
  @pkill -f jayjay-gpui 2>/dev/null || true
  @repo="{{repo}}"; if [[ -z "$repo" ]]; then repo="{{invocation_directory()}}"; fi; \
    open -n -a "{{root}}/build/gpui/JayJay.app" --args "$repo"

gpui-appimage:
  @if [[ "$(uname -s)" != "Linux" ]]; then \
    echo "gpui-appimage requires Linux"; \
    exit 1; \
  fi
  @tmp="$(mktemp -d)"; \
    trap 'rm -rf "$tmp"' EXIT; \
    mkdir -p "{{root}}/build/gpui-appimage"; \
    rsync -a --exclude .git --exclude .jj --exclude target --exclude build --exclude .DS_Store "{{root}}/" "$tmp/"; \
    nix build "$tmp#appimage" \
      --out-link "{{root}}/build/gpui-appimage/result" \
      --extra-experimental-features 'nix-command flakes'; \
    appimage="{{root}}/build/gpui-appimage/jayjay-gpui-$(uname -m)-linux.AppImage"; \
    cp -L "{{root}}/build/gpui-appimage/result" "$appimage"; \
    (cd "{{root}}/build/gpui-appimage" && sha256sum "$(basename "$appimage")" | tee "$(basename "$appimage").sha256"); \
    ls -lh "{{root}}/build/gpui-appimage"

gpui-test:
  cargo test -p jayjay-gpui
