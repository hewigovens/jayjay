# Write a new version + build number into every source of truth.
set-version new_version new_build:
  bash "{{root}}/scripts/version.sh" set "{{new_version}}" "{{new_build}}"

# Verify every version source agrees with shell/justfile's version + build_number.
check-version:
  bash "{{root}}/scripts/version.sh" check "{{version}}" "{{build_number}}"

ffi: ffi-debug

ffi-debug: (_ffi "debug")

ffi-release: (_ffi "release")

# Build the Rust FFI staticlib, generate the Swift bindings, and assemble the
# XCFramework for the given cargo profile (debug | release).
_ffi profile:
  mkdir -p "{{bindings_dir}}" "{{headers_dir}}" "{{swift_out}}"
  MACOSX_DEPLOYMENT_TARGET="{{deployment_target}}" \
  CFLAGS_aarch64_apple_darwin="{{macos_min_flag}}" \
  CXXFLAGS_aarch64_apple_darwin="{{macos_min_flag}}" \
  RUSTFLAGS="-C link-arg={{macos_min_flag}}" \
  cargo build {{ if profile == "release" { "--release" } else { "" } }} --target "{{macos_target}}" -p jayjay-uniffi
  cargo build {{ if profile == "release" { "--release" } else { "" } }} -p jayjay-uniffi --bin uniffi-bindgen
  "{{target_dir}}/{{profile}}/uniffi-bindgen" generate \
    --library "{{target_dir}}/{{macos_target}}/{{profile}}/{{lib_name}}" \
    --language swift \
    --out-dir "{{bindings_dir}}" \
    --config "{{uniffi_config}}"
  cp "{{bindings_dir}}/JayJayFFI.h" "{{headers_dir}}/"
  cp "{{bindings_dir}}/JayJayFFI.modulemap" "{{headers_dir}}/module.modulemap"
  cp "{{bindings_dir}}/JayJayCore.swift" "{{swift_out}}/"
  rm -rf "{{xcframework}}"
  xcodebuild -create-xcframework \
    -library "{{target_dir}}/{{macos_target}}/{{profile}}/{{lib_name}}" \
    -headers "{{headers_dir}}" \
    -output "{{xcframework}}" | xcbeautify

help:
  bash "{{root}}/scripts/build-help-book.sh" "{{root}}"

build: ffi sync-icon help
  cargo build -p jayjay-cli
  xcodegen --spec "{{project}}/project.yml" --project "{{project}}"
  xcodebuild \
    -project "{{project}}/JayJay.xcodeproj" \
    -scheme JayJay \
    -configuration Debug \
    -sdk macosx \
    -derivedDataPath "{{derived_data}}" \
    build | xcbeautify
  cp "{{target_dir}}/debug/jayjay" "{{app}}/Contents/MacOS/jayjay-cli"
  codesign --force --sign - "{{app}}"
  @echo "Built {{app}}"

test: ffi sync-icon help
  xcodegen --spec "{{project}}/project.yml" --project "{{project}}"
  xcodebuild \
    -project "{{project}}/JayJay.xcodeproj" \
    -scheme JayJay \
    -configuration Debug \
    -sdk macosx \
    -derivedDataPath "{{derived_data}}" \
    test | xcbeautify

# Build deterministic jj fixtures at /tmp/jayjay-test-fixtures and set the
# onboarding-complete user default so fresh machines don't show the welcome
# screen during tests.
ui-test-setup:
  #!/usr/bin/env bash
  set -euo pipefail
  # Identity for the fixture commits; silences jj's "Name and email not configured" on CI.
  export JJ_USER="JayJay CI" JJ_EMAIL="ci@jayjay.local"
  defaults write {{bundle_id}} jayjay.hasCompletedOnboarding -bool YES
  # Start each run with the command palette at its default (centered) position.
  defaults delete {{bundle_id}} commandPalette.frameOrigin 2>/dev/null || true

  root=/tmp/jayjay-test-fixtures
  rm -rf "$root"
  mkdir -p "$root"

  # Simple: three commits + an active working copy with two new files.
  # Clone once, then copy per-class for tests that mutate repo state so leaks
  # don't bleed across scenes (NewChangeScene creates a new @).
  jj git init --colocate "$root/simple"
  (
    cd "$root/simple"
    echo "# Sample project" > README.md
    jj describe -m "initial"
    jj new -m "add hello"
    echo "hello" > hello.txt
    jj new -m "add feature"
    echo "feature" > feature.txt
    jj bookmark create main -r @
    jj new
    echo "wip 1" > wip1.txt
    echo "wip 2" > wip2.txt
  )
  cp -R "$root/simple" "$root/simple-newchange"
  cp -R "$root/simple" "$root/simple-commit"
  cp -R "$root/simple" "$root/simple-editdesc"
  cp -R "$root/simple" "$root/simple-save-description"
  cp -R "$root/simple" "$root/simple-diffstats"
  cp -R "$root/simple" "$root/simple-bookmark-diff"
  (
    cd "$root/simple-bookmark-diff"
    jj bookmark create bookmark-diff -r @
  )

  # Conflict: @ is a rebased change with one file containing multiple conflicts.
  jj git init --colocate "$root/conflict"
  (
    cd "$root/conflict"
    printf '%s\n' \
      "project = jayjay" \
      "" \
      "[alpha]" \
      "value = base-alpha" \
      "keep = alpha context" \
      "" \
      "[beta]" \
      "value = base-beta" \
      "keep = beta context" \
      "" \
      "[gamma]" \
      "value = base-gamma" \
      "keep = gamma context" \
      > file.txt
    jj describe -m "base"
    jj bookmark create main -r @
    jj new -m "main: conflicting edits"
    printf '%s\n' \
      "project = jayjay" \
      "" \
      "[alpha]" \
      "value = main-alpha" \
      "keep = alpha context" \
      "" \
      "[beta]" \
      "value = main-beta" \
      "keep = beta context" \
      "" \
      "[gamma]" \
      "value = main-gamma" \
      "keep = gamma context" \
      > file.txt
    jj bookmark set main -r @
    jj new -r 'main-' -m "feature: conflicting edits"
    printf '%s\n' \
      "project = jayjay" \
      "" \
      "[alpha]" \
      "value = feature-alpha" \
      "keep = alpha context" \
      "" \
      "[beta]" \
      "value = feature-beta" \
      "keep = beta context" \
      "" \
      "[gamma]" \
      "value = feature-gamma" \
      "keep = gamma context" \
      > file.txt
    jj rebase -r @ -d main
  )
  cp -R "$root/conflict" "$root/conflict-use-ours"

# Run the macOS UI test bundle. Pass a test-id to narrow the run, e.g.:
#   just shell::ui-test JayJayUITests/CommandPaletteScene/testOpenAndSearch
ui-test test_id='': ffi sync-icon help ui-test-setup
  #!/usr/bin/env bash
  set -euo pipefail
  xcodegen --spec "{{project}}/project.yml" --project "{{project}}"
  args=(
    -project "{{project}}/JayJay.xcodeproj"
    -scheme JayJayUITests
    -configuration Debug
    -sdk macosx
    -derivedDataPath "{{derived_data}}"
  )
  if [[ -n "{{test_id}}" ]]; then
    args+=(-only-testing:"{{test_id}}")
  fi
  xcodebuild "${args[@]}" test | xcbeautify

reset-help-cache:
  #!/usr/bin/env bash
  set -euo pipefail
  killall Tips "Help Viewer" HelpViewer helpd tipsd 2>/dev/null || true

  cache_roots=(
    "$HOME/Library/Group Containers/group.com.apple.helpviewer.content/Library/Caches"
    "$HOME/Library/Caches/com.apple.helpd/Generated"
    "$HOME/Library/Caches/com.apple.helpd/fsCachedData"
    "$HOME/Library/Containers/com.apple.helpviewer/Data/Library/Caches/com.apple.helpviewer"
    "$HOME/Library/Containers/com.apple.helpviewer/Data/Library/HTTPStorages/com.apple.helpviewer"
    "$HOME/Library/HTTPStorages"
    "$HOME/Library/HTTPStorages/com.apple.helpd"
  )

  for cache_root in "${cache_roots[@]}"; do
    if [[ -d "$cache_root" ]]; then
      find "$cache_root" -mindepth 1 -maxdepth 2 \( \
        -iname "*jayjay*" -o \
        -iname "{{bundle_id}}*" -o \
        -iname "dev.hewig.jayjay.manual*" -o \
        -iname "dev.hewig.jayjay.help*" \
      \) -exec rm -rf {} +
    fi
  done

  rm -f \
    "$HOME/Library/Caches/com.apple.helpd/CSHelpIndex.plist" \
    "$HOME/Library/Caches/com.apple.helpd/HelpCache.plist" \
    "$HOME/Library/Caches/com.apple.helpd/HSTS.plist" \
    "$HOME/Library/Caches/com.apple.helpd/Cache.db" \
    "$HOME/Library/Caches/com.apple.helpd/Cache.db-shm" \
    "$HOME/Library/Caches/com.apple.helpd/Cache.db-wal"

  help_pref="$HOME/Library/Preferences/com.apple.help.plist"
  if [[ -f "$help_pref" ]]; then
    python3 -c 'import plistlib, sys; from pathlib import Path; path = Path(sys.argv[1]); bundle_id = sys.argv[2]; plist = plistlib.load(path.open("rb")); registered = plist.get("RegisteredBooks"); keys = [key for key in registered if isinstance(key, str) and key.startswith(bundle_id)] if isinstance(registered, dict) else []; [registered.pop(key, None) for key in keys]; order = plist.get("RegistrationOrder"); has_order = isinstance(order, list); filtered = [item for item in order if not (isinstance(item, str) and item.startswith(bundle_id))] if has_order else order; has_order and plist.__setitem__("RegistrationOrder", filtered); changed = bool(keys) or (has_order and filtered != order); changed and path.write_bytes(plistlib.dumps(plist))' "$help_pref" "{{bundle_id}}"
  fi

  killall Tips "Help Viewer" HelpViewer helpd tipsd 2>/dev/null || true

debug-help:
  #!/usr/bin/env bash
  set -euo pipefail

  source_help="{{help_source}}"
  generated_help="{{help_bundle}}"
  embedded_help="{{app}}/Contents/Resources/JayJay.help"

  print_help_bundle() {
    local label="$1"
    local bundle="$2"
    echo
    echo "== $label =="
    echo "$bundle"
    if [[ ! -d "$bundle" ]]; then
      echo "missing"
      return
    fi
    plutil -p "$bundle/Contents/Info.plist" | grep -E 'CFBundleVersion|CFBundleShortVersionString|HPDBookTitle|HPDBookIndexPath|HPDBookAccessPath' || true
    du -sh "$bundle" "$bundle/Contents/Resources/English.lproj/imgs" 2>/dev/null || true
    echo "image counts:"
    find "$bundle/Contents/Resources/English.lproj/imgs" -maxdepth 1 -type f \( -name '*.jpg' -o -name '*.png' -o -name '*.webp' \) -print 2>/dev/null \
      | sed 's/.*\.//' \
      | sort \
      | uniq -c || true
    echo "help index:"
    file "$bundle/Contents/Resources/English.lproj/JayJay.helpindex" 2>/dev/null || true
  }

  print_help_bundle "source Help Book templates" "$source_help"
  print_help_bundle "generated Help Book" "$generated_help"
  print_help_bundle "embedded Debug app Help Book" "$embedded_help"

  echo
  echo "== JayJay Help caches =="
  cache_roots=(
    "$HOME/Library/Group Containers/group.com.apple.helpviewer.content/Library/Caches"
    "$HOME/Library/Caches/com.apple.helpd"
    "$HOME/Library/Containers/com.apple.helpviewer"
    "$HOME/Library/HTTPStorages"
  )
  found_cache=0
  for cache_root in "${cache_roots[@]}"; do
    if [[ -d "$cache_root" ]]; then
      while IFS= read -r path; do
        found_cache=1
        echo "$path"
      done < <(find "$cache_root" -maxdepth 4 -iname '*jayjay*' -print 2>/dev/null)
    fi
  done
  if [[ "$found_cache" == "0" ]]; then
    echo "none"
  fi

  echo
  echo "== Spotlight Help Book records =="
  spotlight_records="$(mdfind 'kMDItemCFBundleIdentifier == "dev.hewig.jayjay.manual"' 2>/dev/null || true)"
  if [[ -n "$spotlight_records" ]]; then
    echo "$spotlight_records"
  else
    echo "none"
  fi

  echo
  echo "== Registered JayJay Help books =="
  help_pref="$HOME/Library/Preferences/com.apple.help.plist"
  if [[ -f "$help_pref" ]]; then
    if ! plutil -p "$help_pref" 2>/dev/null \
      | grep -E -C 3 'dev\.hewig\.jayjay|JayJay\.help|JayJayHelpBook|build/help\.noindex|Resources/JayJay\.help'; then
      echo "none"
    fi
  else
    echo "none"
  fi

  echo
  echo "== Recent Help logs =="
  log show --last 10m --style compact --predicate 'process != "log" AND (eventMessage CONTAINS[c] "JayJay.help" OR eventMessage CONTAINS[c] "JayJay Manual" OR eventMessage CONTAINS[c] "outside the sandbox" OR eventMessage CONTAINS[c] "Failed to index")' 2>/dev/null \
    | tail -50 || true

run repo='': build reset-help-cache
  @killall JayJay 2>/dev/null || true
  @if [[ -n "{{repo}}" ]]; then \
    repo_path="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "{{repo}}")"; \
    open -n "{{app}}" --args --repo "$repo_path"; \
  else \
    open -n "{{app}}"; \
  fi

