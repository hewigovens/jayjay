# Maintainer: Hewig Ovens <hewigovens@gmail.com>
# Update this release package after both AppImage assets are published, then regenerate .SRCINFO.

pkgname=jayjay-appimage
pkgver=0.3.17
pkgrel=1
# CI overrides pkgver and _tag for pre-releases, whose hyphenated tags are not valid pkgver values.
_tag="v${pkgver}"
pkgdesc="Native desktop client for Jujutsu version control"
arch=('x86_64' 'aarch64')
url="https://jayjay.hewig.dev/"
license=('BUSL-1.1')
depends=('fontconfig' 'fuse3' 'gcc-libs' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-driver' 'vulkan-icd-loader' 'wayland' 'xdg-utils')
options=('!strip')
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/hewigovens/jayjay/${_tag}/LICENSE")
source_x86_64=("jayjay-gpui-x86_64-linux.AppImage::https://github.com/hewigovens/jayjay/releases/download/${_tag}/jayjay-gpui-x86_64-linux.AppImage")
source_aarch64=("jayjay-gpui-aarch64-linux.AppImage::https://github.com/hewigovens/jayjay/releases/download/${_tag}/jayjay-gpui-aarch64-linux.AppImage")
noextract=('jayjay-gpui-x86_64-linux.AppImage' 'jayjay-gpui-aarch64-linux.AppImage')
sha256sums=('5450f4b263bbbfc9b90e843051f739a20b1484d142a1ea7a7a2d37899d6e2578')
sha256sums_x86_64=('2c06e568d28a5ed860b6aba04fc199b97521e7ec5ea03142c2bdaf227b19e2ca')
sha256sums_aarch64=('90794c2e08cb089ec98cba2338ede137b53de5fd7df306ea8dc9088d728fec6e')

prepare() {
  local _appimage="jayjay-gpui-${CARCH}-linux.AppImage"
  rm -rf "${srcdir}/squashfs-root"
  chmod +x "${_appimage}"
  "./${_appimage}" --appimage-extract >/dev/null
  chmod -R a-x+rX squashfs-root/usr
}

package() {
  local _appimage="jayjay-gpui-${CARCH}-linux.AppImage"
  local _metainfo
  _metainfo=$(find squashfs-root -path '*/share/metainfo/dev.hewig.JayJay.metainfo.xml' -print -quit)
  test -n "${_metainfo}"
  install -Dm755 "${_appimage}" "${pkgdir}/opt/${pkgname}/JayJay.AppImage"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 squashfs-root/dev.hewig.JayJay.desktop \
    "${pkgdir}/usr/share/applications/dev.hewig.JayJay.desktop"
  install -Dm644 "${_metainfo}" \
    "${pkgdir}/usr/share/metainfo/dev.hewig.JayJay.metainfo.xml"
  install -dm755 "${pkgdir}/usr/share/icons"
  cp -a squashfs-root/usr/share/icons/. "${pkgdir}/usr/share/icons/"
  install -dm755 "${pkgdir}/usr/bin"
  ln -s "/opt/${pkgname}/JayJay.AppImage" "${pkgdir}/usr/bin/jayjay-gpui"
  ln -s "/opt/${pkgname}/JayJay.AppImage" "${pkgdir}/usr/bin/jayjay"
}
