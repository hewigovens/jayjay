{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [".", "../src/github/PullManifest.ts", "../src/github/PullRequestRef.ts", "../src/github/SignIn.ts", "../src/github/NotesExport.ts", "../src/github/samples.ts"]
}
