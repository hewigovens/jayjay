{
  "name": "@jayjay/diff",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "bash ../../scripts/build-diff-web.sh",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run wasm && npm run build:ui",
    "build:ui": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "check": "tsc --noEmit && tsc --noEmit -p worker && oxlint src worker tests browser",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@jayjay/review-web": "0.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
