{
  "setup": [
    "bash",
    "scripts/screenshot-fixture.sh",
    "/Users/Shared/jayjay-example"
  ],
  "repo": "/Users/Shared/jayjay-example/flightdeck",
  "rows": "/Users/Shared/jayjay-example/rows.tsv",
  "window": [
    60,
    60,
    1440,
    860
  ],
  "env": {
    "JJ_CONFIG": "/Users/Shared/jayjay-example/jj-config.toml",
    "JAYJAY_REPOSITORIES_PATH": "/Users/Shared/jayjay-example/repositories.json",
    "JAYJAY_RECENT_REVSETS_PATH": "/Users/Shared/jayjay-example/recent-revsets.json",
    "JAYJAY_REVIEW_STORE_PATH": "/Users/Shared/jayjay-example/review-store.json"
  },
  "defaults": {
    "ApplePersistenceIgnoreState": true,
    "jayjay.appearanceMode": "dark",
    "jayjay.tintWindowWithWallpaper": false,
    "jayjay.fontFamily": "system",
    "jayjay.fontSize": 12,
    "jayjay.treeFileList": false,
    "jayjay.sideBySideDiff": false,
    "jayjay.hideReviewedFiles": false,
    "jayjay.sidebarHidden": false,
    "jayjay.sidebarWidth": "",
    "jayjay.secondaryPaneWidth": "",
    "jayjay.fileColumnWidth": "",
    "jayjay.hasCompletedOnboarding": true,
    "jayjay.sponsorDismissed": true,
    "jayjay.windowFrame.repo-window": "${window}"
  },
  "prelude": [
    {
      "wait": {
        "idPrefix": "dag.row."
      },
      "timeout": 30
    },
    {
      "click": {
        "row": "include transfer time"
      }
    },
    {
      "beat": 1
    }
  ],
  "steps": [
    {
      "beat": 1.8
    },
    {
      "click": {
        "row": "include transfer time"
      },
      "label": "Before: header above the diff only; file list beside it; status bar at the bottom"
    },
    {
      "beat": 3.5
    },
    {
      "beat": 1.8
    },
    {
      "scroll": {
        "idPrefix": "diff.section",
        "index": 0
      },
      "lines": 18,
      "label": "First file auto-selected; scrolling moves only that diff; header stays"
    },
    {
      "beat": 3.5
    },
    {
      "beat": 1.8
    },
    {
      "scroll": {
        "idPrefix": "diff.section",
        "index": 0
      },
      "lines": -30,
      "label": "Full paths repeat the file name in every row"
    },
    {
      "beat": 3.5
    },
    {
      "beat": 1.8
    },
    {
      "click": {
        "file": "src/routes.rs"
      },
      "label": "Each file is a separate click; there is no all-files view"
    },
    {
      "beat": 3.5
    },
    {
      "beat": 1.8
    },
    {
      "click": "diff.layoutToggle",
      "label": "Unified / side-by-side is a button on every file header"
    },
    {
      "beat": 3.5
    },
    {
      "beat": 1.8
    },
    {
      "click": "diff.layoutToggle",
      "label": "Back to unified"
    },
    {
      "beat": 3.5
    },
    {
      "beat": 1.8
    },
    {
      "key": "cmd+shift+u",
      "label": "Op log is a modal sheet that blocks the window"
    },
    {
      "beat": 3.5
    },
    {
      "beat": 1.8
    },
    {
      "key": "escape",
      "label": "Close it"
    },
    {
      "beat": 3.5
    },
    {
      "beat": 1.8
    },
    {
      "click": "toolbar.sidebarToggle",
      "label": "Sidebar toggle is the first toolbar item"
    },
    {
      "beat": 3.5
    },
    {
      "beat": 1.8
    },
    {
      "click": "toolbar.sidebarToggle",
      "label": "Toolbar also carries Finder and Settings buttons"
    },
    {
      "beat": 3.5
    },
    {
      "beat": 1.8
    },
    {
      "click": {
        "idPrefix": "dag.row.",
        "index": 0
      },
      "label": "Working copy: commit form lives at the bottom of the sidebar; review circles on every file"
    },
    {
      "beat": 3.5
    }
  ]
}