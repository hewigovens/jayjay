#!/bin/bash
set -euo pipefail

SELF="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "${SELF}")/.." && pwd)"
JUSTFILE="${ROOT_DIR}/Justfile"

usage() {
  cat <<'EOF'
Usage: jayjay [--build-only] [--repo PATH | PATH]

Examples:
  jayjay
  jayjay .
  jayjay --repo /path/to/repo
  jayjay --build-only
EOF
}

repo=""
build_only=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --build-only)
      build_only=1
      shift
      ;;
    --repo|-r)
      repo="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [[ -n "${repo}" ]]; then
        echo "unexpected extra argument: $1" >&2
        usage >&2
        exit 1
      fi
      repo="$1"
      shift
      ;;
  esac
done

if [[ -n "${repo}" ]]; then
  repo="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "${repo}")"
fi

if [[ "${build_only}" -eq 1 ]]; then
  exec just --justfile "${JUSTFILE}" build
fi

if [[ -n "${repo}" ]]; then
  exec just --justfile "${JUSTFILE}" run "${repo}"
fi

exec just --justfile "${JUSTFILE}" run
